{
  "expo": {
    "name": "Angkut Sampah",
    "slug": "angkut-sampah",
    "version": "2.0.0",
    "orientation": "portrait",
    "platforms": ["android"],
    "android": {
      "package": "com.angkut.sampah",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Izinkan Angkut Sampah mengakses lokasi untuk penjemputan sampah"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Izinkan akses foto untuk laporan sampah"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Izinkan kamera untuk foto sampah"
        }
      ]
    ]
  }
}
